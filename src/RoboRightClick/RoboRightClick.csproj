<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Required by the COM source generators ([GeneratedComInterface]). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RoboRightClick</AssemblyName>
    <RootNamespace>RoboRightClick</RootNamespace>
  </PropertyGroup>

  <!-- Uncompressed on purpose: when COM starts the tray for a right-click, Explorer waits
       for it, and decompressing the bundle on every launch adds to that wait. Disk size
       does not matter here; first-activation time does (measured in M0 spike 1). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RoboRightClick.Core/RoboRightClick.Core.csproj" />
  </ItemGroup>

  <!-- IBM Plex for the Gridline design language (docs/gridline.md). Embedded and loaded
       with PrivateFontCollection.AddMemoryFont, so nothing is installed system-wide.
       Source: Arch ttf-ibm-plex 6.4.0; SIL OFL 1.1, licence shipped next to the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="RoboRightClick.Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts\LICENSE-IBM-Plex-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
